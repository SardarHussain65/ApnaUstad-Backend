        {
          "name": "Worker Management",
          "item": [
            {
              "name": "1. Get All Workers (Admin)",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/workers",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "workers"]
                }
              }
            },
            {
              "name": "2. Get Worker Details (Admin)",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/workers/{{worker_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "workers", "{{worker_id}}"]
                }
              }
            },
            {
              "name": "3. Verify Worker",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"isVerified\": true\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/workers/{{worker_id}}/verify",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "workers", "{{worker_id}}", "verify"]
                }
              }
            },
            {
              "name": "4. Toggle Worker Active Status",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"isActive\": false\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/workers/{{worker_id}}/status",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "workers", "{{worker_id}}", "status"]
                }
              }
            }
          ]
