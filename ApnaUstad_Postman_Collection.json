      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "1. Admin Login",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@apnaustad.com\",\n  \"password\": \"Admin@123\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/login",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "login"]
                }
              }
            },
            {
              "name": "2. Get Admin Profile",
              "request": {
                "method": "GET",
                "header": [
