          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"User Name\",\n  \"phone\": \"03001234567\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"address\": \"House 123, Street 4\",\n  \"city\": \"Lahore\",\n  \"latitude\": 31.5204,\n  \"longitude\": 74.3587\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "register"]
            }
          }
        },
        {
