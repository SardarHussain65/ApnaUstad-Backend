# ====================================================================
# ApnaUstad Backend — Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ====================================================================

# --- Server ---
PORT=5001
NODE_ENV=development
# CLIENT_URL: Comma-separated allowed origins for CORS.
# In development, use * or http://localhost:3000
# In production, set to your actual frontend URLs.
CLIENT_URL=http://localhost:3000,http://localhost:5173

# --- JWT Authentication ---
# IMPORTANT: Use strong, randomly generated secrets (minimum 64 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES_64
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES_64
REFRESH_TOKEN_EXPIRES_IN=30d

# --- MongoDB ---
# Use a connection string with authentication
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/ApnaUstad

# --- ImageKit (Image CDN) ---
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# --- Admin Seed Account ---
# Used only for initial admin creation. Change immediately after first login.
ADMIN_EMAIL=admin@apnaustad.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --- Resend (Email Service) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Apna Ustad <support@yourdomain.com>

# --- Firebase Admin SDK ---
# Paste the full JSON service account key as a single-line string wrapped in quotes.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'
ALLOW_FIREBASE_INIT_FAILURE=true

# --- Platform Settings ---
PLATFORM_FEE_PERCENTAGE=10
MINIMUM_WALLET_BALANCE=500

# --- Worker Wallet Payment Methods ---
WALLET_EASYPAISA_ACCOUNT_TITLE=Account Holder Name
WALLET_EASYPAISA_NUMBER=03XXXXXXXXX
WALLET_EASYPAISA_ENABLED=true

WALLET_JAZZCASH_ACCOUNT_TITLE=Account Holder Name
WALLET_JAZZCASH_NUMBER=03XXXXXXXXX
WALLET_JAZZCASH_ENABLED=true

WALLET_BANK_ACCOUNT_TITLE=Account Holder Name
WALLET_BANK_NAME=Bank Name
WALLET_BANK_ACCOUNT_NUMBER=XXXXXXXXXXXXXXXX
WALLET_BANK_IBAN=PKXXXXXXXXXXXXXXXXXX
WALLET_BANK_ENABLED=true

WALLET_OTHER_ENABLED=false
WALLET_OTHER_METHOD_LABEL=Other Method
WALLET_OTHER_ACCOUNT_TITLE=
WALLET_OTHER_ACCOUNT_NUMBER=
WALLET_OTHER_INSTRUCTIONS=
